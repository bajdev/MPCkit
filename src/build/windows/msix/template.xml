<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="mpckit"
        Arguments=""
        InstallLocation="C:\Program Files\MPCkit">
    </Installer>
    <PackageInformation
        PackageName="mpckit"
        PackageDisplayName="MPCkit"
        PublisherName="CN=bajdev"
        PublisherDisplayName="bajdev"
        Version="0.1.0.0"
        PackageDescription="MPCkit, a kit editor for the MPC Sample">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.monoexp.mpckit"
                Description="MPCkit, a kit editor for the MPC Sample"
                DisplayName="MPCkit"
                ExecutableName="mpckit"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>MPCkit</DisplayName>
            <PublisherDisplayName>bajdev</PublisherDisplayName>
            <Description>MPCkit, a kit editor for the MPC Sample</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="mpckit.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
